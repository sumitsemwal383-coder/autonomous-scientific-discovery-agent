# Enterprise Secure Execution Sandbox for AI Scientific Agent
# Hardened minimal execution image
FROM python:3.11-slim

# Create isolated non-root user
RUN groupadd -r sandboxuser && useradd -r -g sandboxuser -u 1001 sandboxuser

# Install scientific dependencies
RUN pip install --no-cache-dir \
    numpy==1.26.4 \
    scipy==1.12.0 \
    pandas==2.2.1 \
    scikit-learn==1.4.1.post1 \
    matplotlib==3.8.3

# Set secure execution workspace
WORKDIR /app
RUN chown -R sandboxuser:sandboxuser /app

# Switch to unprivileged user
USER sandboxuser

# Default execution entrypoint
CMD ["python", "--version"]
